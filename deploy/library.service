# systemd unit — copy to /etc/systemd/system/library.service, adjust paths, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now library
[Unit]
Description=Library (personal book library)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=library
WorkingDirectory=/opt/book-library
EnvironmentFile=/opt/book-library/.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/book-library/data

[Install]
WantedBy=multi-user.target
