# Copy to .env and adjust.

# Password for the app (strongly recommended on any server). Leave empty for no login.
LIBRARY_PASSWORD=

# Where to listen. Use 0.0.0.0 only behind a reverse proxy / firewall.
HOST=127.0.0.1
PORT=8080

# Database + image cache location.
DATA_DIR=./data

# Set to true when behind a TLS-terminating reverse proxy (Caddy, nginx, Traefik).
TRUST_PROXY=false

# Optional: keeps you logged in this many days (default 60).
# SESSION_DAYS=60

# Optional: your email, sent in the User-Agent as Open Library asks API clients to.
# CONTACT_EMAIL=you@example.com

# Optional: a Markdown export to load into an empty database on first start.
# LIBRARY_IMPORT=/path/to/library.md
